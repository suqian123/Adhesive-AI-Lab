MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=adhesive_app
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=adhesive_ai_lab
MYSQL_CONNECT_TIMEOUT=5

# 一键多尺度计算（按实际安装的软件修改）
# 命令中包含 {task_file} 时，程序会将 task.json 交给自定义包装器；包装器负责生成并校验求解器输入。
# 还可使用 {task_dir}、{candidate_id} 和 {campaign_id} 占位符。
ADHESIVE_DFT_ENGINE=VASP
ADHESIVE_DFT_COMMAND=
ADHESIVE_DFT_RESULT_FILE=OUTCAR
ADHESIVE_BULK_MD_ENGINE=LAMMPS
ADHESIVE_BULK_MD_COMMAND=
ADHESIVE_BULK_MD_RESULT_FILE=log.lammps
ADHESIVE_INTERFACE_MD_ENGINE=LAMMPS
ADHESIVE_INTERFACE_MD_COMMAND=
ADHESIVE_INTERFACE_MD_RESULT_FILE=log.lammps
ADHESIVE_CG_ENGINE=LAMMPS
ADHESIVE_CG_COMMAND=
ADHESIVE_CG_RESULT_FILE=log.lammps
ADHESIVE_CAMPAIGN_MAX_PARALLEL=16

# DFT 吸附能计算需要时填写，并保证与任务输出采用一致参考态。
ADHESIVE_DFT_SURFACE_ENERGY_EV=
ADHESIVE_DFT_OXYGEN_ENERGY_EV=
